# Write pico9918-core's version out as a header Classic99 can include.
#
# (C) 2026 Troy Schrapel (visrealm)
#
# The config block carries a version stamp, and pico9918_config_validate() uses
# it to decide whether stored settings need migrating - so it has to be the
# library's real version, not a number copied into our tree that goes stale on
# the next submodule bump. CMake consumers read it out of the subproject's
# directory scope; MSBuild has no equivalent, so the pre-build step runs this
# with `cmake -P` instead.
#
#   cmake -DSRC=<pico9918-core dir> -DOUT=<header path> -P pico9918_core_version.cmake

if(NOT DEFINED SRC OR NOT DEFINED OUT)
  message(FATAL_ERROR "pico9918_core_version.cmake needs -DSRC=<dir> and -DOUT=<file>")
endif()

file(READ "${SRC}/CMakeLists.txt" _text)

string(REGEX MATCH "project\\(pico9918_core[ \t\r\n]+VERSION[ \t\r\n]+([0-9]+)\\.([0-9]+)\\.([0-9]+)"
       _matched "${_text}")

if(NOT _matched)
  message(FATAL_ERROR
    "could not read VERSION from ${SRC}/CMakeLists.txt - the config block's version "
    "stamp gates the stored-settings migration, so an empty one cannot be built around.")
endif()

set(_major ${CMAKE_MATCH_1})
set(_minor ${CMAKE_MATCH_2})
set(_patch ${CMAKE_MATCH_3})

set(_body "/* GENERATED by 3rdparty/pico9918_core_version.cmake - do not edit. */
#ifndef PICO9918_CORE_VERSION_H
#define PICO9918_CORE_VERSION_H

#define PICO9918_CORE_VER_MAJOR ${_major}
#define PICO9918_CORE_VER_MINOR ${_minor}
#define PICO9918_CORE_VER_PATCH ${_patch}
#define PICO9918_CORE_VER_STRING \"${_major}.${_minor}.${_patch}\"

#endif
")

# Only rewrite when it changed, so this does not retrigger a rebuild every time.
set(_old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _body)
  file(WRITE "${OUT}" "${_body}")
  message(STATUS "pico9918-core version ${_major}.${_minor}.${_patch} -> ${OUT}")
endif()
